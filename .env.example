# =============================================================================
# CosmeticDeepStat Agents — Environment configuration template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -------- LLM provider (provider-agnostic) --------
# One of: anthropic | openai | google | azure_openai | bedrock | mock
LLM_PROVIDER=mock

# Model identifier in deepagents' "provider:model" notation OR a bare model id
# resolved by init_chat_model.
LLM_MODEL=anthropic:claude-sonnet-4-5-20250929

# Per-provider keys (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2025-03-01-preview

# -------- App settings --------
APP_ENV=dev                 # dev | staging | prod
APP_LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Root directory for the agentic filesystem (workspace/{study_id}/...)
WORKSPACE_ROOT=./workspace

# Memory root (long-term markdown notes loaded by the master agent)
MEMORY_ROOT=./memories

# Skills root (deepagents will scan SKILL.md frontmatter here)
SKILLS_ROOT=./skills

# -------- Storage --------
# SQLite is fine for local dev; switch to Postgres for production.
DATABASE_URL=sqlite:///./cosmetic_deepstat.db
# Example Postgres URL:
# DATABASE_URL=postgresql+psycopg://cdsa:cdsa_dev@localhost:5432/cdsa

# Object storage (S3-compatible). Leave empty to use local filesystem only.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=

# Vector store (RAG over regulatory docs / SOPs). Optional in MVP.
VECTOR_STORE_BACKEND=none    # none | chroma | qdrant | pgvector

# -------- Security --------
APP_SECRET_KEY=change-me-please
ALLOW_DATA_MUTATION_IN_RAW=false   # MUST remain false in prod
PSEUDONYMIZE_SUBJECTS=true

# -------- Observability --------
ENABLE_AUDIT_TRAIL=true
AUDIT_LOG_PATH=./workspace/_audit/audit.jsonl

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cosmetic-deepstat-agents
